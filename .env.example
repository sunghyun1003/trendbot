# ─────────────────────────────────────────────────────────────
# ㄷㅅㅂㄱ 설정 파일 예시
# 1) 이 파일을 복사해 이름을 .env 로 바꾸세요. (.env 는 저장소에 올라가지 않습니다)
# 2) = 뒤에 값을 붙여 넣으세요. 따옴표·띄어쓰기 없이.
# 3) 발급 방법: docs/keys-guide.md
# 4) 다 넣었으면 확인: python -m trendbot doctor
# ─────────────────────────────────────────────────────────────

# [필수] AI 편집자 (Claude). 안내서 1번
ANTHROPIC_API_KEY=

# [권장] 유튜브 급상승 영상 찾기. 비워 두면 유튜브만 빠짐. 안내서 2번
YOUTUBE_API_KEY=

# [필수] 사이트 올리기 (Cloudflare Pages). 안내서 3번
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_PAGES_PROJECT=trendbot

# [선택] 팀원 피드백(유지/제외 버튼) 가져오기. 안내서 4번
SITE_URL=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
EXPORT_TOKEN=
